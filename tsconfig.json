{
  "extends": "@grafana/tsconfig/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./compiled",
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "paths": {
      "@grafana/plugin-compat/datasources": ["./node_modules/@grafana/plugin-compat/dist/types/datasources.d.ts"]
    },
    "rootDirs": ["."]
  },
  "exclude": ["dist/**/*"],
  "include": ["utils/**/*.ts*", "src/**/*.ts*"],
  "ts-node": {
    "compilerOptions": {
      "isolatedModules": false,
      "module": "commonjs"
    }
  }
}
